{
  "manifest_version": 3,
  "name": "SubClean Sync",
  "version": "1.0.0",
  "description": "SubClean - 구독 정보 동기화 확장 프로그램. ID/PW를 저장하지 않고, 현재 로그인된 페이지의 구독 정보만 읽습니다.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.naver.com/*",
    "https://nid.naver.com/*",
    "https://www.coupang.com/*",
    "https://www.youtube.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.baemin.com/*"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.naver.com/*", "https://nid.naver.com/*"],
      "js": ["src/content/naverAdapter.js"]
    },
    {
      "matches": ["https://www.coupang.com/*"],
      "js": ["src/content/coupangAdapter.js"]
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content/youtubeAdapter.js"]
    },
    {
      "matches": ["https://chat.openai.com/*"],
      "js": ["src/content/chatgptAdapter.js"]
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/content/claudeAdapter.js"]
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["src/content/geminiAdapter.js"]
    },
    {
      "matches": ["https://www.baemin.com/*"],
      "js": ["src/content/baeminAdapter.js"]
    }
  ]
}
