# Supabase (필수)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google OAuth 는 Supabase 가 서버 측에서 중개한다.
# Client ID / Secret 은 Supabase Dashboard → Authentication → Providers → Google
# 에만 입력하며, 여기에 넣지 않는다 (VITE_ 변수는 빌드 번들에 그대로 박힌다).

# 웹 푸시 (VAPID 공개키 — 공개돼도 되는 값)
# 비밀키는 Supabase Edge Function 시크릿(VAPID_PRIVATE_KEY)에만 넣는다.
VITE_VAPID_PUBLIC_KEY=

# 개발 환경 표시
VITE_APP_ENV=development